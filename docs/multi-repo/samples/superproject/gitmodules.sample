# リポジトリルートに置く標準の .gitmodules（ファイル名は必ず .gitmodules）
# oimo は workspace.yaml / repos.txt が無いときこれを読み、
#   superproject（親・原則 read-only）+ 各 submodule（実装単位）
# を Registry へ登録する。
#
# oimo が読むキー（Git 標準）:
#   [submodule "<name>"]  … name → id の候補
#   path = <相対パス>     … 必須。checkout 位置
#   url  = <clone URL>    … 推奨
#   branch = <追跡ブランチ> … 任意。behind 警告のヒント（fetch はしない）
#
# 詳細: docs/multi-repo/config-reference.ja.md
# 使い方:
#   git submodule add <url> <path>
# またはこの内容を書いた後、承認のうえで:
#   git submodule update --init --recursive

[submodule "frontend"]
	path = frontend
	url = https://github.com/example-org/frontend.git
	branch = main

[submodule "backend"]
	path = backend
	url = https://github.com/example-org/backend.git
	branch = main

[submodule "shared-schema"]
	path = packages/shared-schema
	url = https://github.com/example-org/shared-schema.git
	branch = main

[submodule "infra"]
	path = infra
	url = https://github.com/example-org/customer-infra.git
	branch = main
